_, price, qty, cat in self.lines)\n18: \n19:     def total(self):\n20:         gross = self.net_cents() + self.tax_cents()\n21:         return from_cents(gross - gross * self.discount_percent // 100)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"invoice/invoice.py\",\"offset\":1,\"limit\":400}"},"time":{"start":1794301179541,"end":1794301179904}}}}

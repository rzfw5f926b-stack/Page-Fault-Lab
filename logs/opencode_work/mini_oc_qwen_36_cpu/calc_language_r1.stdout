ve.\"\"\"\n45:         left = self.parse_term()\n46:         while True:\n47:             tok = self.peek()\n48:             if tok and tok[0] == \"OP\" and tok[1] in (\"+\", \"-\"):\n49:                 op = self.advance()[1]\n50:                 right = self.parse_term()\n51:                 left = (\"bin\", op, left, right)\n52:             else:\n53:                 break\n54:         return left\n55: \n56:     def parse_term(self):\n57:         \"\"\"Multiplicative: *, /, %, left associative.\"\"\"\n58:         left = self.parse_power()\n59:         while True:\n60:             tok = self.peek()\n61:             if tok and tok[0] == \"OP\" and tok[1] in (\"*\", \"/\", \"%\"):\n62:                 op = self.advance()[1]\n63:                 right = self.parse_power()\n64:                 left = (\"bin\", op, left, right)\n65:             else:\n66:                 break\n67:         return left\n68: \n69:     def parse_power(self):\n70:         \"\"\"Exponentiation: **, right associative.\"\"\"\n71:         base = self.parse_unary()\n72:         tok = self.peek()\n73:         if tok and tok[0] == \"OP\" and tok[1] == \"**\":\n74:             self.advance()\n75:             exp = self.parse_power()  # right assoc → recurse here\n76:             return (\"bin\", \"**\", base, exp)\n77:         return base\n78: \n79:     def parse_unary(self):\n80:         \"\"\"Unary +/- (lower precedence than **).\"\"\"\n81:         tok = self.peek()\n82:         if tok and tok[0] == \"OP\" and tok[1] in (\"+\", \"-\"):\n83:             op = self.advance()[1]\n84:             operand = self.parse_power()\n85:             return (\"unary\", op, operand)\n86:         return self.parse_atom()\n87: \n88:     def parse_atom(self):\n89:         \"\"\"Number, variable, function call, or parenthesized expression.\"\"\"\n90:         tok = self.peek()\n91:         if tok is None:\n92:             raise CalcError(\"unexpected end of expression\")\n93: \n94:         if tok[0] == \"NUM\":\n95:             self.advance()\n96:             return (\"num\", tok[1])\n97: \n98:         if tok[0] == \"NAME\":\n99:             name = self.advance()[1]\n100:             # Check for function call\n101:             next_tok = self.peek()\n102:             if next_tok and next_tok[0] == \"LPAREN\":\n103:                 self.advance()  # consume '('\n104:                 args = []\n105:                 if self.peek() and self.peek()[0] != \"RPAREN\":\n106:                     args.append(self.parse_expr())\n107:                     while self.peek() and self.peek()[0] == \"OP\" and self.peek()[1] == \",\":\n108:                         self.advance()  # consume ','\n109:                         args.append(self.parse_expr())\n110:                 self.expect(\"RPAREN\", \")\")\n111:                 return (\"call\", name, args)\n112:             return (\"var\", name)\n113: \n114:         if tok[0] == \"LPAREN\":\n115:             self.advance()  # consume '('\n116:             node = self.parse_expr()\n117:             self.expect(\"RPAREN\", \")\")\n118:             return node\n119: \n120:         raise CalcError(f\"unexpected token {tok!r}\")\n121: \n122: \n123: def parse(tokens):\n124:     return Parser(tokens).parse()","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file calc/parser.py, lines 1-124\n1: from .errors import CalcError\n2: \n3: \n4: class Parser:\n5:     \"\"\"Recursive-descent parser with precedence levels:\n6:     expr    → additive (+, -)       left assoc\n7:     term    → multiplicative (*, /, %)  left assoc\n8:     power   → exponentiation (**)     right assoc\n9:     unary   → unary +/-             right assoc\n10:     atom    → num, name, call, (...)\n11:     \"\"\"\n12: \n13:     def __init__(self, tokens):\n14:         self.tokens = tokens\n15:         self.pos = 0\n16: \n17:     def parse(self):\n18:         if not self.tokens:\n19:             raise CalcError(\"expected expression, got n
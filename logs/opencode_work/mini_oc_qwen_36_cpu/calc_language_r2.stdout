okens):\n71:         raise CalcError(\"unexpected end of input\")\n72: \n73:     tok = tokens[i]\n74: \n75:     # Number\n76:     if tok[0] == \"NUM\":\n77:         return i + 1, (\"num\", tok[1])\n78: \n79:     # Parenthesized expression\n80:     if tok[0] == \"LPAREN\":\n81:         i += 1\n82:         i, node = _parse_expr(tokens, i)\n83:         if i >= len(tokens) or tokens[i][0] != \"RPAREN\":\n84:             raise CalcError(\"unexpected end of input\")\n85:         return i + 1, node\n86: \n87:     # Identifier: variable or function call\n88:     if tok[0] == \"IDENT\":\n89:         name = tok[1]\n90:         i += 1\n91:         if i < len(tokens) and tokens[i][0] == \"LPAREN\":\n92:             return _parse_call(tokens, i, name)\n93:         return i, (\"var\", name)\n94: \n95:     raise CalcError(f\"unexpected token {tok!r}\")\n96: \n97: \n98: def _parse_call(tokens, i, name):\n99:     \"\"\"Parse function call: name( arg1, arg2, ... ).\"\"\"\n100:     i += 1  # consume (\n101:     args = []\n102:     if i < len(tokens) and tokens[i][0] != \"RPAREN\":\n103:         i, arg = _parse_expr(tokens, i)\n104:         args.append(arg)\n105:         while i < len(tokens) and tokens[i] == (\"OP\", \",\"):\n106:             i += 1\n107:             if i >= len(tokens):\n108:                 raise CalcError(\"malformed expression\")\n109:             i, arg = _parse_expr(tokens, i)\n110:             args.append(arg)\n111:     if i >= len(tokens) or tokens[i][0] != \"RPAREN\":\n112:         raise CalcError(f\"expected ')' in function call\")\n113:     i += 1  # consume )\n114: \n115:     if name == \"min\" or name == \"max\":\n116:         min_args, max_args = 1, float(\"inf\")\n117:     else:\n118:         min_args, max_args = BUILTINS.get(name, (0, 0))\n119: \n120:     if name not in BUILTINS:\n121:         raise CalcError(f\"unknown function {name!r}\")\n122:     if not (min_args <= len(args) <= max_args):\n123:         raise CalcError(f\"{name}() expects {min_args if min_args == max_args else f'{min_args}-{max_args}'} argument(s)\")\n124: \n125:     return i, (\"call\", name, args)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/private/var/folders/0r/cvjfflsx01g6z8zy2wlgf6dm0000gn/T/flashback_opencode_work/mini_oc_qwen_36_cpu/calc_language_r2/calc/parser.py\"}"},"time":{"start":1794308090852,"end":1794308099387}}}}

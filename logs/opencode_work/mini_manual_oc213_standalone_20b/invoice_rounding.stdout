ty, cat in self.lines)\n18: \n19:     def total(self):\n20:         gross = self.net_cents() + self.tax_cents()\n21:         return from_cents(gross - gross * self.discount_percent // 100)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"invoice/invoice.py\",\"limit\":400}"},"time":{"start":1794237571604,"end":1794237571913}}}}

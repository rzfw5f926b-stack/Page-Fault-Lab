return int(float(amount) * 100)\n+    from decimal import Decimal, ROUND_HALF_UP\n+    return int((Decimal(amount) * Decimal(100)).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n \n \n def from_cents(cents):\n     return f\"{cents / 100:.2f}\"\n","additions":2,"deletions":1},"truncated":false},"title":"invoice/money.py","time":{"start":1794161536337,"end":1794161536340}},"id":"prt_1bc5c61bb001mKG0YBjfwP7Lct","sessionID":"ses_e43a4c68fffesy5Agmp1oCskHu","messageID":"msg_1bc5c5c040014MRIVaXD0n6tPC"}}

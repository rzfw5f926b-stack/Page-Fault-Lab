+ self.tax_cents()","truncated":false,"loaded":[],"display":{"type":"file","path":"/Volumes/LLM SSD/Flashback/logs/opencode_work/air_oc_qwen_fmt/invoice_rounding/invoice/invoice.py","text":"from .money import from_cents, to_cents\nfrom .tax import tax_cents\n\n\nclass Invoice:\n    def __init__(self, discount_percent=0):\n        self.lines = []\n        self.discount_percent = discount_percent\n\n    def add_line(self, description, unit_price, quantity, category=\"standard\"):\n        self.lines.append((description, to_cents(unit_price), quantity, category))\n\n    def net_cents(self):\n        return sum(price * qty for _, price, qty, _ in self.lines)\n\n    def tax_cents(self):\n        return sum(tax_cents(price * qty, cat) for _, price, qty, cat in self.lines)\n\n    def total(self):\n        gross = self.net_cents() + self.tax_cents()\n        return from_cents(gross - gross * self.discount_percent // 100)","lineStart":1,"lineEnd":21,"totalLines":21,"truncated":false}},"title":"invoice/invoice.py","time":{"start":1794199495123,"end":1794199495136}},"id":"prt_1be9f6144001SKOMzAa7S5xZwG","sessionID":"ses_e41682c3effet7GmnTYe5DnBrs","messageID":"msg_1be9ed801001W1B8fELS88SNuj"}}
